# Copy to /etc/quant-platform/worker.env on the target host (root:qp-worker, mode 0640).
# This file is intentionally non-secret. Do not put database passwords here: libpq reads the
# password from the passfile named in the DSN (mode 0600, owned by qp-worker).

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# The worker login (platform_worker, db/init/005_runtime_roles.sh).
QP_RUNTIME_DSN="host=127.0.0.1 port=5433 dbname=market_catalog user=platform_worker passfile=/etc/quant-platform/worker.pgpass"

# Directory of the process-lifetime lock file. Every worker of one database must use the same
# directory, including one an operator starts by hand; it must be covered by ReadWritePaths= in the unit.
QP_WORKER_LOCK_DIR=/run/lock
QP_WORKER_POLL_SECONDS=1.0

# The commit is read from the checkout (`git rev-parse HEAD`) and must equal the one the API
# recorded. Do not set QP_GIT_COMMIT on a server with a Git checkout.
