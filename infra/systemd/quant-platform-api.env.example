# Copy to /etc/quant-platform/api-server.env on the target host (root:qp-api, mode 0640).
# This file is intentionally non-secret. Do not put database passwords or private keys here:
# libpq reads the password from the passfile named in the DSN (mode 0600, owned by qp-api), and
# the TLS private key is a file read at startup.

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Both DSNs use the API login (platform_api, db/init/005_runtime_roles.sh). The catalog DSN serves
# market-data reads; the runtime DSN is where the API records its deployment commit at startup.
CATALOG_DSN="host=127.0.0.1 port=5433 dbname=market_catalog user=platform_api passfile=/etc/quant-platform/api.pgpass"
QP_RUNTIME_DSN="host=127.0.0.1 port=5433 dbname=market_catalog user=platform_api passfile=/etc/quant-platform/api.pgpass"

# Loopback is the default. Reaching the API from another machine needs BOTH a non-loopback address
# here and QP_API_ALLOW_NON_LOOPBACK=true, and then the complete TLS/mTLS material below (ADR-0063).
QP_API_HOST=127.0.0.1
QP_API_PORT=8765
QP_API_ALLOW_NON_LOOPBACK=false

QP_API_BATCH_SIZE=65536

# Mutual TLS 1.3 material (infra/pki/, docs/engineering/DECK_PKI_OPERATIONS.md). Files, not values.
QP_API_TLS_CERTIFICATE=/etc/quant-platform/tls/server.crt
QP_API_TLS_PRIVATE_KEY=/etc/quant-platform/tls/server.key
QP_API_CLIENT_TRUST_ANCHOR=/etc/quant-platform/tls/ca.crt
QP_API_PRINCIPALS_FILE=/etc/quant-platform/principals.json

# Message families this host serves. Empty (the default) keeps the J02 v1 market-data server.
# Available: strategy,validation,training,jobs,admitted-input,result-import. The deck handoff needs
# admitted-input and result-import.
QP_API_FAMILIES=admitted-input,result-import

# The deployment commit is read from the checkout (`git rev-parse HEAD`). Do not set QP_GIT_COMMIT
# on a server with a Git checkout: it would decouple the recorded commit from the code that runs.
