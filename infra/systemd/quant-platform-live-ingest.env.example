# Copy to /etc/quant-platform/live-ingest-server.env on the target host.
# This file is intentionally non-secret. Do not put catalog passwords or
# provider credentials here; libpq must read the catalog password from
# PGPASSFILE.

PGHOST=127.0.0.1
PGPORT=5433
PGUSER=market_catalog_writer
PGDATABASE=market_catalog
PGPASSFILE=/home/mkt-transform/.pgpass

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

QP_LIVE_INGEST_STORAGE_ROOT=/srv/marketdata
QP_LIVE_INGEST_STORAGE_ROOT_ID=hot
QP_LIVE_INGEST_CHECKPOINT_PATH=/srv/marketdata/canonical/_k10_checkpoints/live-ingest-server-v1.json
QP_LIVE_INGEST_PRODUCER=live-ingest-server-v1
# Set to the exact deployed Git SHA before target proof or production start.
QP_LIVE_INGEST_CODE_REF=REPLACE_WITH_DEPLOYED_GIT_SHA

QP_LIVE_INGEST_RECENT_LIMIT=1000
QP_LIVE_INGEST_MAX_MESSAGES_PER_CYCLE=1000
QP_LIVE_INGEST_MAX_SECONDS_PER_CYCLE=20
QP_LIVE_INGEST_CYCLE_INTERVAL_SECONDS=5

# Session mode (ADR-0075, DG-O). cycles (the default; empty means cycles) is the bounded cycle loop; continuous keeps ONE WebSocket
# session open between publications. The three bounds apply to continuous only and an empty value is the default (300 s, 50000
# trades, 20000 messages): leave them empty with cycles, the server refuses a bound together with cycles. Changing the mode is a
# restart of the unit, an operator step; the checkpoint and the published partitions are the same in both modes.
QP_LIVE_INGEST_MODE=cycles
QP_LIVE_INGEST_SLICE_SECONDS=
QP_LIVE_INGEST_SLICE_MAX_TRADES=
QP_LIVE_INGEST_BUFFER_MESSAGES=

QP_LIVE_INGEST_PRESSURE_AVAILABLE_BYTES=53687091200
QP_LIVE_INGEST_PRESSURE_CRITICAL_AVAILABLE_BYTES=21474836480
QP_LIVE_INGEST_PRESSURE_EXHAUSTED_AVAILABLE_BYTES=5368709120
QP_LIVE_INGEST_PRESSURE_MAX_CAPACITY_AGE_SECONDS=300
