# Artefatti Python
__pycache__/
*.py[cod]
*.so

# Ambienti virtuali e cache di test
.venv/
venv/
.pytest_cache/
site/
.orchestrator/

# Segreti: il .env del catalogo vive in /srv/docker/market-catalog, non qui,
# ma la regola resta come rete di sicurezza se qualcuno lo copiasse nel repo.
.env
*.env
!env.example

# Bulk market data and generated research artifacts. Small fixtures remain
# explicitly tracked under fixtures/.
*.parquet
*.db
*.sqlite
*.sqlite3
*.arrow
*.feather
data/
!src/quant_platform/data/
!src/quant_platform/data/*.py
artifacts/
cache/
/orchestrator.toml
/.orchestrator.db
.worktrees/
.claude/settings.local.json
.claude/.settings.local.json.lock
